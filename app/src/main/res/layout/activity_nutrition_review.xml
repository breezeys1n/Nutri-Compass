<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_100">

    <!-- 顶部渐变条 - 固定不滚动 -->
    <View
        android:id="@+id/header_gradient"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@drawable/gradient_header"
        android:layout_alignParentTop="true" />

    <!-- 返回按钮 - 固定在左上角 -->
    <include
        android:id="@+id/back_button"
        layout="@layout/layout_back_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true" />

    <!-- 标题 - 固定在青色框内 -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="视觉营养复盘"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="45dp" />

    <!-- 提示文字 - 放在青色框内，标题下方 -->
    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="拍摄餐前餐后照片，AI分析实际摄入"
        android:textSize="13sp"
        android:textColor="@color/white"
        android:alpha="0.9"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/tv_title"
        android:layout_marginTop="6dp" />

    <!-- 可滚动内容区域 - 从青色框底部开始 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_gradient"
        android:fillViewport="true"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <!-- 餐前照片区域卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🍽️ 餐前食物"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_800"
                        android:layout_marginBottom="12dp" />

                    <ImageView
                        android:id="@+id/iv_before_meal"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:scaleType="centerCrop"
                        android:background="@color/gray_200"
                        android:contentDescription="餐前食物照片"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_before_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未上传"
                        android:textSize="13sp"
                        android:textColor="@color/gray_500"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <Button
                            android:id="@+id/btn_take_before"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="44dp"
                            android:text="拍摄"
                            android:textColor="@color/white"
                            android:backgroundTint="@color/primary_mint"
                            app:cornerRadius="22dp"
                            android:layout_marginEnd="6dp"
                            android:elevation="2dp" />

                        <Button
                            android:id="@+id/btn_pick_before"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="44dp"
                            android:text="相册"
                            android:textColor="@color/gray_700"
                            android:backgroundTint="@color/white"
                            app:cornerRadius="22dp"
                            android:layout_marginStart="6dp"
                            app:strokeColor="@color/gray_300"
                            app:strokeWidth="1dp"
                            android:elevation="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 餐后照片区域卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🍽️ 餐后剩余"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_800"
                        android:layout_marginBottom="12dp" />

                    <ImageView
                        android:id="@+id/iv_after_meal"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:scaleType="centerCrop"
                        android:background="@color/gray_200"
                        android:contentDescription="餐后剩余照片"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_after_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未上传"
                        android:textSize="13sp"
                        android:textColor="@color/gray_500"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <Button
                            android:id="@+id/btn_take_after"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="44dp"
                            android:text="拍摄"
                            android:textColor="@color/white"
                            android:backgroundTint="@color/primary_mint"
                            app:cornerRadius="22dp"
                            android:layout_marginEnd="6dp"
                            android:elevation="2dp" />

                        <Button
                            android:id="@+id/btn_pick_after"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="44dp"
                            android:text="相册"
                            android:textColor="@color/gray_700"
                            android:backgroundTint="@color/white"
                            app:cornerRadius="22dp"
                            android:layout_marginStart="6dp"
                            app:strokeColor="@color/gray_300"
                            app:strokeWidth="1dp"
                            android:elevation="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 分析按钮 -->
            <Button
                android:id="@+id/btn_analyze"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="🔍 开始AI分析"
                android:textColor="@color/white"
                android:enabled="false"
                android:backgroundTint="@color/gray_400"
                app:cornerRadius="26dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp" />

            <!-- 进度条 -->
            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

            <!-- 分析结果卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/white">

                <TextView
                    android:id="@+id/tv_analysis_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="分析结果将显示在这里..."
                    android:textSize="14sp"
                    android:textColor="@color/gray_700"
                    android:lineSpacingExtra="4dp"
                    android:padding="20dp"
                    android:minHeight="120dp" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>