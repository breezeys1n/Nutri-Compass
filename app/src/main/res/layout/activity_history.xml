<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_100">

    <!-- 顶部渐变条 - 高度调小一点 -->
    <View
        android:id="@+id/header_gradient"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@drawable/gradient_header"
        android:layout_alignParentTop="true" />

    <!-- 返回按钮 - 放在左上角，和其他页面统一 -->
    <include
        android:id="@+id/back_button"
        layout="@layout/layout_back_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true" />

    <!-- 标题 - 放在青色框内居中 -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="历史记录"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="60dp" />

    <!-- 历史列表 - 从青色框底部开始 -->
    <ListView
        android:id="@+id/listView_history"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_gradient"
        android:layout_above="@id/bottom_container"
        android:layout_marginTop="8dp"
        android:divider="@null"
        android:dividerHeight="8dp"
        android:padding="16dp"
        android:paddingBottom="8dp" />

    <!-- 空状态容器 -->
    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerInParent="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_empty_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📝"
            android:textSize="64sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="暂无历史记录"
            android:textSize="16sp"
            android:textColor="@color/gray_500"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <!-- 底部按钮容器 - 两个按钮并排 -->
    <LinearLayout
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/white"
        android:elevation="8dp">

        <!-- 清空历史记录按钮 -->
        <Button
            android:id="@+id/btn_clear_history"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="清空历史记录"
            android:textColor="@color/white"
            android:backgroundTint="@color/gray_500"
            app:cornerRadius="24dp"
            android:layout_marginEnd="8dp" />

        <!-- 周报告按钮 - 放在右边 -->
        <Button
            android:id="@+id/btn_weekly_report"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="查看周报告"
            android:textColor="@color/white"
            android:backgroundTint="@color/primary_mint"
            app:cornerRadius="24dp"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</RelativeLayout>