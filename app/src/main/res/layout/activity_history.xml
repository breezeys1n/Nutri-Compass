<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_with_overlay">

    <!-- 返回按钮 -->
    <include
        android:id="@+id/back_button"
        layout="@layout/layout_back_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true" />

    <!-- 标题栏 - 修改为包含标题和按钮 -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@android:color/transparent"
        android:padding="16dp"
        android:elevation="0dp"
        android:layout_below="@id/back_button"
        android:gravity="center_vertical">

        <!-- 标题 -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="历史记录"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/primary_green"
            android:gravity="center" />

        <!-- 周报告按钮（新增） -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_weekly_report"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="周报告"
            android:textSize="14sp"
            app:cornerRadius="20dp"
            android:backgroundTint="@color/accent_orange"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:minWidth="0dp"
            android:layout_marginEnd="8dp"
            android:elevation="2dp" />
    </LinearLayout>

    <!-- 空状态提示 -->
    <TextView
        android:id="@+id/tv_empty_history"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="暂无历史记录\n\n点击下方按钮生成你的第一个食谱吧！"
        android:textSize="16sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:layout_centerInParent="true"
        android:visibility="gone" />

    <!-- 历史列表 -->
    <ListView
        android:id="@+id/listView_history"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:layout_above="@id/bottom_button_container"
        android:divider="@color/light_green"
        android:dividerHeight="1dp"
        android:padding="8dp" />

    <!-- 底部按钮容器（新增） -->
    <LinearLayout
        android:id="@+id/bottom_button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center">

        <!-- 周报告按钮（移动到底部） - 如果上面不需要可以删除上面的，保留这个 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_weekly_report_bottom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="查看周报告"
            android:textSize="16sp"
            android:padding="12dp"
            app:cornerRadius="8dp"
            android:backgroundTint="@color/primary_green"
            android:layout_marginEnd="8dp"
            android:elevation="4dp" />

        <!-- 清空历史按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_clear_history"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="清空历史记录"
            android:textSize="16sp"
            android:padding="12dp"
            app:cornerRadius="8dp"
            android:backgroundTint="@color/accent_orange"
            android:layout_marginStart="8dp"
            android:elevation="4dp" />
    </LinearLayout>

</RelativeLayout>