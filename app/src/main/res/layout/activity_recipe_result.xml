<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_100">

    <!-- 顶部渐变条 - 固定不滚动 -->
    <View
        android:id="@+id/header_gradient"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@drawable/gradient_header"
        android:layout_alignParentTop="true" />

    <!-- 返回按钮 - 固定在左上角 -->
    <include
        android:id="@+id/back_button"
        layout="@layout/layout_back_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true" />

    <!-- 标题 - 固定在青色框内 -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI营养师推荐"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="45dp" />

    <!-- 可滚动内容区域 - 从青色框底部开始 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_gradient"
        android:fillViewport="true"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <!-- 用户数据卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/white">

                <TextView
                    android:id="@+id/tv_user_data"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="为您定制"
                    android:textSize="13sp"
                    android:textColor="@color/gray_600"
                    android:gravity="center"
                    android:padding="12dp" />
            </androidx.cardview.widget.CardView>

            <!-- 食谱名称卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tv_recipe_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="番茄炒蛋"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_800"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_recipe_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="经典家常菜，营养均衡"
                        android:textSize="14sp"
                        android:textColor="@color/gray_600" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 推荐理由卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="推荐理由"
                        android:textSize="14sp"
                        android:textColor="@color/primary_mint"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_recipe_reason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="根据您的减脂目标和现有食材，这道菜蛋白质丰富，热量适中..."
                        android:textSize="14sp"
                        android:textColor="@color/gray_700"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_weather_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🌤️ 北京 晴 23°C"
                        android:textSize="13sp"
                        android:textColor="@color/gray_500"
                        android:background="@color/gray_100"
                        android:padding="8dp"
                        android:gravity="center"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 食材卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🥕 所需食材"
                        android:textSize="16sp"
                        android:textColor="@color/gray_800"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:id="@+id/layout_ingredients_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 时间难度卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center"
                    android:weightSum="3">

                    <!-- 准备时间 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⏱️"
                            android:textSize="22sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="准备"
                            android:textSize="11sp"
                            android:textColor="@color/gray_500"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/tv_prep_time_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10分钟"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_800" />
                    </LinearLayout>

                    <!-- 烹饪时间 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔥"
                            android:textSize="22sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="烹饪"
                            android:textSize="11sp"
                            android:textColor="@color/gray_500"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/tv_cook_time_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15分钟"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_800" />
                    </LinearLayout>

                    <!-- 难度 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐"
                            android:textSize="22sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="难度"
                            android:textSize="11sp"
                            android:textColor="@color/gray_500"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/tv_difficulty_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="简单"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_800" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 烹饪步骤卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="👨‍🍳 烹饪步骤"
                            android:textSize="16sp"
                            android:textColor="@color/gray_800"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btn_voice_control"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@android:drawable/ic_btn_speak_now"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="语音朗读"
                            app:tint="@color/primary_mint" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_steps_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 营养信息卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📊 营养数据"
                        android:textSize="16sp"
                        android:textColor="@color/gray_800"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tv_recipe_nutrition"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="热量: 220大卡 | 蛋白质: 15g | 碳水: 10g | 脂肪: 12g"
                        android:textSize="14sp"
                        android:textColor="@color/gray_700"
                        android:lineSpacingExtra="4dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_200"
                        android:layout_marginVertical="12dp" />

                    <TextView
                        android:id="@+id/tv_cooking_tips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="💡 小贴士：搭配一份绿叶蔬菜营养更均衡！"
                        android:textSize="13sp"
                        android:textColor="@color/secondary_coral"
                        android:padding="10dp"
                        android:background="@color/secondary_coral_light"
                        app:cornerRadius="6dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 操作按钮组 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/btn_next_step"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="开始烹饪"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/primary_mint"
                    app:cornerRadius="26dp"
                    android:layout_marginEnd="6dp"
                    android:elevation="2dp" />

                <Button
                    android:id="@+id/btn_flavor_migration"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="风味改良"
                    android:textColor="@color/gray_700"
                    android:backgroundTint="@color/white"
                    app:cornerRadius="26dp"
                    android:layout_marginStart="6dp"
                    app:strokeColor="@color/gray_300"
                    app:strokeWidth="1dp"
                    android:elevation="2dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>